---
interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Nalansitan 的个人博客，记录技术、阅读与思考。",
} = Astro.props;
const pageTitle = title ? `${title} · Nalansitan` : "Nalansitan";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Nalansitan" href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="返回首页">N<span>.</span></a>
      <nav aria-label="主导航">
        <a href="/">文章</a>
        <a href="/about/">关于</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Nalansitan</span>
      <span>Built with Astro · Hosted on GitHub Pages</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f5f2ea;
    --surface: #fcfaf5;
    --text: #22211f;
    --muted: #706d66;
    --line: #d9d4c8;
    --accent: #d44b2b;
    --max: 760px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background:
      radial-gradient(circle at 10% 0%, rgba(212, 75, 43, .08), transparent 27rem),
      var(--bg);
    color: var(--text);
    font-size: 17px;
    line-height: 1.75;
  }

  a { color: inherit; text-decoration: none; }

  .site-header, main, footer {
    width: min(calc(100% - 40px), var(--max));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0;
  }

  .brand {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  .brand span { color: var(--accent); }

  nav { display: flex; gap: 24px; }

  nav a, footer {
    color: var(--muted);
    font-size: .9rem;
  }

  nav a:hover { color: var(--accent); }

  main { min-height: calc(100vh - 190px); padding: 64px 0 96px; }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding: 24px 0 36px;
  }

  h1, h2, h3 {
    font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
    line-height: 1.25;
    letter-spacing: -.02em;
  }

  h1 { font-size: clamp(2.6rem, 9vw, 5.2rem); margin: 0; }
  h2 { font-size: 1.6rem; margin-top: 2.5em; }
  p { margin: 1.2em 0; }
  code { font-size: .9em; }
  pre { overflow-x: auto; padding: 20px; border-radius: 12px; }

  @media (max-width: 600px) {
    .site-header { padding-top: 22px; }
    main { padding-top: 44px; }
    footer { flex-direction: column; }
  }
</style>
