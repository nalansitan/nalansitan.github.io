---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { getLocaleFromUrl, ui } from "@/i18n";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { alternatePath, articleDate, description, ogImage, title },
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const pageDescription = description ?? ui[locale].seoDescription;
---

<html class="scroll-smooth" lang={locale}>
	<head>
		<BaseHead alternatePath={alternatePath} articleDate={articleDate} description={pageDescription} ogImage={ogImage} title={title} />
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 pt-16 font-sans text-[15px] font-normal antialiased sm:px-8"
	>
		<SkipLink />
		<Header alternatePath={alternatePath} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
