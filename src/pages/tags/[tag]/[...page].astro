---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getTagMeta, getTranslatedTag, getUniqueTags } from "@/data/post";
import { defaultLocale, getLocaleFromUrl, type Locale, localizePath, ui } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getTagPagePaths = async (
	{ paginate }: Parameters<GetStaticPaths>[0],
	locale: Locale,
) => {
	const allPosts = await getAllPosts(locale);
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(sortedPosts);

	return uniqueTags.flatMap((tag) => {
		const postsWithTag = sortedPosts.filter((post) => post.data.tags.includes(tag));
		return paginate(postsWithTag, {
			pageSize: 10,
			params: { tag },
		});
	});
};

export const getStaticPaths = ((context) =>
	getTagPagePaths(context, defaultLocale)) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { tag } = Astro.params;
const locale = getLocaleFromUrl(Astro.url);
const t = ui[locale];
const tagMeta = await getTagMeta(tag, locale);
const alternateLocale = locale === "en" ? "zh-CN" : "en";
const translatedTag = tagMeta
	? await getTranslatedTag(tagMeta.data.translationKey, alternateLocale)
	: undefined;
const alternatePath = translatedTag
	? localizePath(`/tags/${translatedTag.data.route}/`, alternateLocale)
	: undefined;

const TagContent = tagMeta ? (await render(tagMeta)).Content : null;

const meta = {
	description:
		tagMeta?.data.description ??
		(locale === "en" ? `View all posts tagged ${tag}.` : `查看标签为 ${tag} 的全部文章。`),
	title: tagMeta?.data.title ?? (locale === "en" ? `Posts about ${tag}` : `关于 ${tag} 的文章`),
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: t.previous,
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: t.next,
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={{ ...meta, alternatePath }}>
	<nav class="mb-8" aria-label={locale === "en" ? "Breadcrumb" : "面包屑导航"}>
		<ul class="flex items-center">
			<li class="flex items-center">
				<a class="text-accent" href={localizePath("/tags/", locale)}>{t.tags}</a>
				<Icon aria-hidden="true" name="mdi:chevron-right" class="mx-1.5" />
			</li>
			<li aria-current="page" class=""><span aria-hidden="true">#</span>{tag}</li>
		</ul>
	</nav>
	<h1 class="title capitalize">
		{tagMeta?.data.title ?? (locale === "en" ? `Posts about ${tag}` : `关于 ${tag} 的文章`)}
	</h1>
	<div class="prose prose-sm prose-cactus mb-16 max-w-none">
		{tagMeta?.data.description && <p>{tagMeta.data.description}</p>}
		{TagContent && <TagContent />}
	</div>
	<ul class="space-y-4">
		{
			page.data.map((p) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
					<PostPreview as="h2" post={p} />
				</li>
			))
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
