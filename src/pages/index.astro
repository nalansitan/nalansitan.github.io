---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">NALANSITAN’S NOTEBOOK</p>
    <h1>保持好奇，<br /><em>持续构建。</em></h1>
    <p class="intro">记录技术实践、阅读所得，以及那些值得反复思考的问题。</p>
  </section>

  <section class="posts" aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">最新文章</h2>
      <span>{posts.length.toString().padStart(2, "0")}</span>
    </div>
    {posts.map((post) => (
      <article>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>{post.data.tags.join(" · ")}</span>
        </div>
        <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <a class="read-more" href={`/posts/${post.id}/`}>阅读全文 <span>→</span></a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .hero { padding: 40px 0 120px; }
  .eyebrow {
    color: var(--accent);
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .18em;
    margin-bottom: 24px;
  }
  h1 em { color: var(--accent); font-weight: inherit; }
  .intro {
    color: var(--muted);
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.2rem;
    max-width: 520px;
    margin-top: 32px;
  }
  .section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--text);
  }
  .section-title h2 { margin: 0 0 12px; }
  .section-title span { color: var(--muted); font-size: .8rem; }
  article { padding: 40px 0; border-bottom: 1px solid var(--line); }
  article h3 { font-size: clamp(1.7rem, 5vw, 2.35rem); margin: 12px 0; }
  article h3 a:hover { color: var(--accent); }
  article p { color: var(--muted); margin: 0 0 18px; }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--muted);
    font-size: .76rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .read-more { color: var(--accent); font-size: .88rem; font-weight: 650; }
  .read-more span { display: inline-block; transition: transform .2s ease; }
  .read-more:hover span { transform: translateX(4px); }
  @media (max-width: 600px) {
    .hero { padding-bottom: 84px; }
    .meta { flex-direction: column; gap: 2px; }
  }
</style>
