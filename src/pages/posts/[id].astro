---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.pubDate);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header>
      <a class="back" href="/">← 返回文章列表</a>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
        <span>{post.data.tags.join(" · ")}</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back { color: var(--accent); font-size: .85rem; }
  header { border-bottom: 1px solid var(--line); padding-bottom: 36px; }
  h1 { font-size: clamp(2.5rem, 8vw, 4.5rem); margin: 28px 0 20px; }
  .description { color: var(--muted); font-family: Georgia, "Noto Serif SC", serif; font-size: 1.18rem; }
  .meta { display: flex; justify-content: space-between; color: var(--muted); font-size: .8rem; margin-top: 28px; }
  .prose { font-family: Georgia, "Noto Serif SC", "Songti SC", serif; max-width: 680px; padding-top: 36px; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 600px) { .meta { flex-direction: column; } }
</style>
