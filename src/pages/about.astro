---
import { getLocaleFromUrl, ui } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = ui[locale];
const meta = {
	description: t.aboutDescription,
	title: t.about,
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">{t.about}</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		{
			locale === "en" ? (
				<>
					<p>Hi, I’m Nalansitan.</p>
					<p>This is my personal blog for software engineering, reading notes, and long-term thinking.</p>
					<p>Good writing is more than publishing conclusions; it is also a way to organize how I think. I hope these notes remain useful to my future self and to anyone who happens to visit.</p>
					<p>The site uses Astro Cactus, Markdown, and pnpm, and is published to GitHub Pages with GitHub Actions.</p>
				</>
			) : (
				<>
					<p>你好，我是 Nalansitan。</p>
					<p>这是我的个人博客，用来记录技术实践、阅读笔记和长期思考。</p>
					<p>我相信好的写作不只是输出结论，也是在整理自己的认知。希望这里的内容对未来的我，以及偶然来到这里的你，都有一点价值。</p>
					<p>网站使用 Astro Cactus、Markdown 和 pnpm 构建，通过 GitHub Actions 发布到 GitHub Pages。</p>
				</>
			)
		}
	</div>
</PageLayout>
