---
import { getLocaleFromUrl } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

const locale = getLocaleFromUrl(Astro.url);
const meta = {
	description: locale === "en" ? "The page you requested does not exist." : "你访问的页面不存在。",
	title: locale === "en" ? "Page not found" : "页面未找到",
};
---

{
	locale === "zh-CN" && (
		<script is:inline>
			if (location.pathname.startsWith("/en/")) {
				const source = encodeURIComponent(location.pathname + location.search);
				location.replace(`/en/404/?from=${source}`);
			}
		</script>
	)
}

<PageLayout meta={meta}>
	<h1 class="title mb-12">404｜{meta.title}</h1>
	<p class="mb-8">
		{
			locale === "en"
				? "This page may have moved or been deleted. Use the navigation to continue."
				: "这个页面可能已经移动或被删除，请通过导航返回。"
		}
	</p>
</PageLayout>
